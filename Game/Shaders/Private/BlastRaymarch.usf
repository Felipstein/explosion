// Cópia do BlastLab (13/10/2026, a morte de tanque da v2): BlastLab/Shaders/Private/BlastRaymarch.usf.
// BlastRaymarch.usf — o raymarch das explosões gravadas do WebGL, portado.
//
// Porte de reference/webgl/js/instances.js (shLight e shSingle) e do composite
// de js/volumeRender.js, com as mesmas constantes (ver BlastRaymarch.cpp). O
// Heterogeneous Volume da Unreal saiu borrado e caro na GTX 1660 (07/10); o
// do WebGL fazia a mesma explosão nítida em ~5 ms. O que ele faz:
// - pula o espaço vazio por uma grade macro (blocos de 4 voxels, dilatada);
// - mistura os dois quadros gravados levando cada um pelos vetores de
//   movimento (flipbook com vetores, em 3D);
// - ruído de detalhe que ANDA com a fumaça (duas fases defasadas, Vlachos 2010 /
//   Neyret 2003) e erosão da borda;
// - cache de luz por explosão (48³): transmitância até o sol e até o fogo;
// - espalhamento múltiplo por oitavas (Wrenninge et al. 2013), fase HG dupla,
//   emissão de corpo negro (Planck × CIE) com reforço na frente de chama;
// - meia resolução com jitter interleaved-gradient e upsample pela
//   profundidade mais parecida (sem halo nas silhuetas).
//
// Espaço: metros, relativo à câmera (o mundo transladado da Unreal / 100).
// Espaço LOCAL de uma explosão: metros na escala da Carga Pesada, origem no
// pé, z pra cima; domínio [−D/2, D/2]² × [0, D]. Radiância nas unidades do
// WebGL (1 = iluminância do sol) até o composite, que leva a cd/m².

#include "/Engine/Private/Common.ush"

#define MAX_INSTANCES 16
#define MAX_STEPS 96
#define PI_F 3.14159265

#define SOOT_F 4.0
#define TEMP_F 1.6
#define DUST_F 2.5
#define FUEL_F 1.0

// ---- grades (BlastRaymarch.cpp) -------------------------------------------
// o tamanho de uma vaga do pool (a maior gravação carregada); cada explosão diz
// o tamanho da gravação dela (InstRes) e os dados ficam no canto da vaga
float Res;            // voxels da vaga por eixo (a maior gravação carregada)
float FuelRes;        // combustível + velocidade (metade)
float MacroRes;       // ocupação macro (um quarto)
float PTRes;          // tabela de blocos (um oitavo)
float LCRes;          // cache de luz (48)
float Slots;          // quadros no pool
float SlotsY;         // lado a lado em y (o resto empilhado em z)
float LCSlots;        // caches de luz no pool
float VelMax;         // m/s

// A gravação em blocos esparsos (Tools/brm2.py, 09/10; o esquema do Sparse Volume
// Texture da Unreal e do NanoVDB): cada quadro tem uma tabela com um bloco de 8³
// voxels por entrada (o endereço dele no atlas, ou vazio), e os blocos com fumaça
// ficam num atlas só, comum a todas as explosões, com 1 voxel de borda copiado do
// vizinho (a filtragem trilinear não emenda errado entre blocos)
Texture3D<uint> PoolPT;       // R32: x | y << 10 | z << 20 do bloco no atlas; 0xFFFFFFFF = vazio
Texture3D<float4> AtlasA;     // RGBA8, blocos de 10³: √(fuligem/4), T/1.6, √(poeira/2.5), transmitância do céu
Texture3D<float4> AtlasF;     // RGBA8, blocos de 6³ (meia resolução): combustível, velocidade (byte·2−1)·VelMax
float3 AtlasASize;            // texels
float3 AtlasFSize;
Texture3D<float> PoolM;       // R8: ocupação macro
Texture3D<float4> Noise;      // T_CurlNoise (ladrilha)
Texture2D<float4> BlackBody;  // rgb normalizado (luminância 1), a = luminância relativa
// A deformação pelo que passa (BattleSmoke.usf MainWarp, 64³ sobre o domínio
// gravado): D em m locais no rgb, a fração recortada (o túnel) no alfa. A
// gravação é lida no ponto y = x − D(x), o mapa característico (Tessendorf &
// Pelfrey; o "rest field" do Houdini), como no material do volume da Unreal.
// O detalhe fino de perto (Nubis Cubed, Schneider SIGGRAPH 2023: a densidade
// grossa ganha bolhas de ruído na casca, as mais finas só com a câmera perto):
// Worley 1 − F1 periódico 128³ (make_noise.py), 4/8/16/32 células por ladrilho
Texture3D<float4> Worley;
float DetailErode;    // modulação da densidade na casca (± fração); 0 = sem detalhe
float DetailTemp;     // a mesma modulação na temperatura (crostas frias na frente do fogo)
float DetailPeriod;   // ciclo das bolhas (s): curto o bastante pra elas não esticarem na bola que sobe
// A borda afiada (Nubis Cubed: o pow() que afia as densidades baixas depois da
// erosão): abaixo de SharpRef a densidade cai como (d/ref)^SharpPow, então a casca
// semitransparente de ~1 m vira um contorno curto e as bolhas da casca ganham borda
float SharpPow;       // 0 = sem
float SharpRef;       // densidade (unidades da fuligem) abaixo da qual afia
// O clarão da detonação (BlastRaymarch.cpp): o quanto dele em cada explosão vem em InstFirePos.w
float FlashGain;      // a emissão × (1 + FlashGain · clarão)
float FlashDT;        // o miolo quente esquenta FlashDT · clarão (unidades de temperatura da gravação; +500 K)
Texture3D<float4> Warp0;
Texture3D<float4> Warp1;
Texture3D<float4> Warp2;
Texture3D<float4> Warp3;
SamplerState LinearClamp;
SamplerState LinearWrap;

// ---- parâmetros do WebGL (instances.js params) ------------------------------
float SootExt;
float DustExt;
float SootAlbedo;
float DustAlbedo;
float3 SootColor;
float3 DustColor;
float EmissionGain;
float EmissionCurve;
float TempScale;
float FlameBoost;
float PhaseG;
float PhaseBack;
float PhaseMix;
float SunOcclude;
float DetailAmp;
float DetailScale;
float DetailDens;
float Erode;
float FlowPeriod;
float DetailAmp2;   // 2ª oitava do detalhe (m locais; o WebGL usava 0.11 só na qualidade máxima, main.js det2)
float SkyGain;
float3 GroundAlbedo;  // a areia que devolve o sol pra baixo da fumaça (0 = desligado; -RmGround=r,g,b; 13/10)
float SunFull;     // 0 = o sol × seno da altura (o "erro" do WebGL, a fumaça preta aprovada); 1 = o sol inteiro (13/10)
float FireGain;
float MsExt;
float MsScatter;
float MsPhase;
int MsOctaves;
int SunSteps;
int FireSteps;

// ---- luz da cena (InitLights, da View: a mesma que acende o resto da cena) -------
static float3 KeyDir;     // pra luz-chave (sol ou lua, a mais forte)
static float3 KeyColor;   // iluminância dela no chão, unidades do WebGL
static float3 KeyGround;  // a mesma sempre com o seno da altura (a névoa da composição)
static float3 KeySun;     // a luz-chave sem o seno (o sol inteiro por explosão)
static float3 GroundColor; // a luz do chão de sol na fumaça, na convenção do céu (radiância de um Lambert: E·albedo/π)
static float3 SkyColor;   // céu do hemisfério de cima / π, unidades do WebGL (envSkyUp)
float RadianceScale;      // unidades do WebGL → cd/m² (128 000: js/atmosphere.js, E_lux / E_render)
float4 FogA;              // a névoa do mapa na explosão: ligada, densidade (1/m), queda (1/m, base 2), começo (m)
float4 FogB;              // albedo (linear), fase g
float FogHeightRel;        // a altura da névoa relativa à câmera (m)
float4 TermGain;          // depuração (-RmTerms=sol,céu,fogo,emissão): 1 = o termo inteiro
int DebugView;            // depuração (-RmDebug=): 1 = transmitância até o sol (branco = sol passa), 2 = até o fogo, 3 = do céu

// ---- instâncias, da mais perto pra mais longe --------------------------------
int NumInstances;
float4 InstFoot[MAX_INSTANCES];    // pé (m, relativo à câmera).xyz, escala
float4 InstFrame[MAX_INSTANCES];   // slot do quadro de baixo, slot do de cima, fração, k (voxels por m/s)
float4 InstMisc[MAX_INSTANCES];    // tempo da gravação (s), seed, fração mantida × espessura, passos
float4 InstNoise[MAX_INSTANCES];   // x: o ruído de detalhe do WebGL nesta (1 = o de sempre; 0 = só a gravação, 13/10)
// a luz e a cor desta explosão (13/10, a morte de tanque no jogo; as outras ficam com as globais): negativo = a global
float4 InstLight2[MAX_INSTANCES];  // x: sol inteiro (0–1), y: ganho do céu
float4 InstGround[MAX_INSTANCES];  // rgb: albedo da areia que devolve o sol; w > 0,5 = usa este
float4 InstDust[MAX_INSTANCES];    // rgb: cor da poeira, a: albedo; x < 0 = a global
float4 InstLight[MAX_INSTANCES];   // slot do cache de luz (<0 = sem), espessura, ganho da emissão, slot da deformação (<0 = sem)
float4 InstBoxMin[MAX_INSTANCES];  // caixa justa no mundo (m, relativo à câmera)
float4 InstBoxMax[MAX_INSTANCES];
float4 InstFirePos[MAX_INSTANCES]; // luz do fogo gravada (m, relativo à câmera)
float4 InstFireCol[MAX_INSTANCES]; // cor dela, unidades do WebGL (já × escala²)
float4 InstLook[MAX_INSTANCES];    // cor da fuligem.rgb, albedo dela (a nuclear muda com o tempo: instances.js _nukeLook)
float4 InstDetail[MAX_INSTANCES];  // o detalhe fino de perto: força das bolhas de 1.2 / 0.6 / 0.3 m, peso da fase quente
float4 InstRes[MAX_INSTANCES];     // a gravação desta: voxels, combustível, macro (96/48/24, 128/64/32, 192/96/48), domínio (m locais)

// ---- tela -----------------------------------------------------------------------
float4x4 ClipToCamera;   // clip (sem jitter) → mundo relativo à câmera (cm)
float3 CameraForward;
float NearM;
uint2 HalfSize;          // a marcha
uint2 OutMin;   // o retângulo da cena na saída (depois do TSR)
uint2 OutSize;
uint2 OutExtent;         // o tamanho da textura de saída
float Jitter;
Texture2D<float> SceneDepth;   // na resolução interna (antes do TSR)
Texture2D<float4> SceneColorIn;
// Duas camadas por texel da marcha (11/10): cada texel cobre vários pixels da cena, e nas folhas a
// profundidade muda de pixel pra pixel. A marcha vai até a cena MAIS LONGE do bloco (a camada de trás)
// e guarda o que já juntou ao passar pela MAIS PERTO (a da frente); cada pixel da tela usa a camada da
// profundidade dele. Com uma camada só (a profundidade do centro do texel), o galho na frente da bola
// pegava a fumaça de trás dele e o céu entre os galhos a de um galho: o quadriculado nas árvores.
Texture2D<float4> VolIn;       // a camada de trás: radiância, transmitância
Texture2D<float4> VolNearIn;   // a camada da frente
Texture2D<float4> VolDepthIn;  // x = a cena mais longe do bloco, y = a profundidade média do volume, z = a cena mais perto do bloco
Texture2D<float4> HistIn;      // as camadas resolvidas do quadro anterior (acúmulo temporal)
Texture2D<float4> HistNearIn;
RWTexture2D<float4> VolOut;
RWTexture2D<float4> VolNearOut;
RWTexture2D<float4> VolDepthOut;
RWTexture2D<float4> HistOut;
RWTexture2D<float4> HistNearOut;
float4x4 CamToPrevClip;  // ponto relativo à câmera (m) → clip do quadro anterior (sem jitter)
float HistValid;         // 0 = sem história (primeiro quadro, mudou o tamanho, pulou quadro)
float HistAlpha;         // peso do quadro novo
RWTexture2D<float4> SceneColorOut;

// ---- cache de luz -------------------------------------------------------------
int LCInstance;
int LCSlot;
Texture3D<float2> PoolLC;      // sol, fogo
RWTexture3D<float2> PoolLCOut;
RWTexture2D<float> ShadowOut;   // a sombra da explosão no chão (MainShadowMap)
float4 ShadowA;                 // canto do mapa relativo à câmera (m) xy, texel (m), o chão relativo à câmera (m)
float4 ShadowB;                 // a direção pro sol, a resolução

// ---- subida dos blocos pro atlas (o UpdateSparseVolumeTexture.usf da Unreal faz igual) ----
StructuredBuffer<uint> BrickData;     // um RGBA8 por texel, bloco a bloco (z, y, x), como no arquivo
StructuredBuffer<uint> BrickCoords;   // onde cada bloco vai no atlas: x | y << 10 | z << 20
RWTexture3D<float4> AtlasOut;

void ScatterBrick(uint K, uint3 L, uint Side)
{
	const uint C = BrickCoords[K];
	const uint3 B = uint3(C & 1023u, (C >> 10u) & 1023u, (C >> 20u) & 1023u);
	const uint V = BrickData[K * Side * Side * Side + (L.z * Side + L.y) * Side + L.x];
	AtlasOut[B * Side + L] = float4(V & 255u, (V >> 8u) & 255u, (V >> 16u) & 255u, V >> 24u) / 255.0;
}

// um grupo por bloco
[numthreads(10, 10, 10)]
void MainScatterA(uint3 G : SV_GroupID, uint3 L : SV_GroupThreadID)
{
	ScatterBrick(G.x, L, 10u);
}

[numthreads(6, 6, 6)]
void MainScatterF(uint3 G : SV_GroupID, uint3 L : SV_GroupThreadID)
{
	ScatterBrick(G.x, L, 6u);
}

// =============================================================================
// utilidades (js/glsl.js)

float3 Hash33(float3 p)
{
	p = float3(dot(p, float3(127.1, 311.7, 74.7)),
	           dot(p, float3(269.5, 183.3, 246.1)),
	           dot(p, float3(113.5, 271.9, 124.6)));
	return frac(sin(p) * 43758.5453123) * 2.0 - 1.0;
}

// dithering interleaved-gradient (Jimenez)
float IGNoise(float2 p)
{
	return frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715))));
}

float PhaseHG(float CosT, float G)
{
	const float G2 = G * G;
	const float D = 1.0 + G2 - 2.0 * G * CosT;
	return (1.0 - G2) / (4.0 * PI_F * max(D * sqrt(max(D, 1e-4)), 1e-4));
}

float PhaseDual(float CosT, float G0, float G1, float W)
{
	return lerp(PhaseHG(CosT, G0), PhaseHG(CosT, -G1), W);
}

float2 RayBox(float3 Ro, float3 Rd, float3 BMin, float3 BMax)
{
	const float3 Inv = 1.0 / (Rd + float3(abs(Rd) < 1e-8) * 1e-8);
	const float3 T0 = (BMin - Ro) * Inv, T1 = (BMax - Ro) * Inv;
	const float3 Tn = min(T0, T1), Tf = max(T0, T1);
	return float2(max(max(Tn.x, Tn.y), Tn.z), min(min(Tf.x, Tf.y), Tf.z));
}

// A luz-chave do WebGL é uma só (o sol de dia, a lua à noite): a mais forte das
// duas luzes da atmosfera, com a transmitância da atmosfera até o chão. O céu é
// a irradiância difusa do SkyLight num chão virado pra cima, ÷ π (o que um
// Lambert de albedo 1 devolve: BasePassPixelShader, GetSkySHDiffuse · SkyLightColor).
void InitLights()
{
	const float3 Sun = View.AtmosphereLightIlluminanceOnGroundPostTransmittance[0].rgb;
	const float3 Moon = View.AtmosphereLightIlluminanceOnGroundPostTransmittance[1].rgb;
	const bool bMoon = dot(Moon, 1.0) > dot(Sun, 1.0);
	KeyDir = normalize((bMoon ? View.AtmosphereLightDirection[1].xyz : View.AtmosphereLightDirection[0].xyz) + 1e-6);
	// A cor da luz-chave do WebGL é a irradiância num chão HORIZONTAL (js/atmosphere.js,
	// texel 0: iluminância × transmitância × max(dir.y, 0)), e a fumaça usa como se
	// fosse a luz de frente: às 15h, com o sol a 26°, ela recebe 0.44 do sol. É a
	// fumaça preta aprovada (como o céu, um "erro" que se reproduz, não se corrige);
	// com a luz inteira ela saía bege (rodada de 08/10, captures/cmp_250.jpg).
	// O sol inteiro (13/10, -RmFullSun=1): os game shots do fim de tarde (alvos 3/6/19) têm a fumaça marrom-clara
	// iluminada; com o sol a ~20° o seno deixava ~1/3 dele e a fumaça saía preta. Um volume não tem normal: a
	// iluminância que chega é a da luz inteira (a névoa e as nuvens da Unreal fazem assim)
	KeyColor = (bMoon ? Moon : Sun) * lerp(max(KeyDir.z, 0.0), 1.0, SunFull) / RadianceScale;
	KeyGround = (bMoon ? Moon : Sun) * max(KeyDir.z, 0.0) / RadianceScale;     // a névoa da composição segue como foi medida
	KeySun = (bMoon ? Moon : Sun) / RadianceScale;
	// A luz que volta do chão (as nuvens da Unreal: VolumetricCloud.usf, GroundAlbedo, o chão Lambert iluminado pelo sol
	// e visto pela metade de baixo da esfera): no deserto a areia ao sol acende a barriga da fumaça (os alvos 3/6/19)
	GroundColor = KeyGround * GroundAlbedo * (1.0 / PI_F);
	const float4 N = float4(0.0, 0.0, 1.0, 1.0);
	float3 I0, I1;
	I0.x = dot(View.SkyIrradianceEnvironmentMap[0], N);
	I0.y = dot(View.SkyIrradianceEnvironmentMap[1], N);
	I0.z = dot(View.SkyIrradianceEnvironmentMap[2], N);
	const float4 VB = N.xyzz * N.yzzx;
	I1.x = dot(View.SkyIrradianceEnvironmentMap[3], VB);
	I1.y = dot(View.SkyIrradianceEnvironmentMap[4], VB);
	I1.z = dot(View.SkyIrradianceEnvironmentMap[5], VB);
	const float3 I2 = View.SkyIrradianceEnvironmentMap[6].xyz * (N.x * N.x - N.y * N.y);
	SkyColor = max(I0 + I1 + I2, 0.0) * View.SkyLightColor.rgb / RadianceScale;
}

// a gravação da explosão sendo marchada (UseRes no começo de cada uma): as de
// outros simuladores (build_raymarch_vdb.py) têm outra resolução e outro domínio
static float GRes, GFuelRes, GMacroRes, GDomain;
void UseRes(int I)
{
	GRes = InstRes[I].x;
	GFuelRes = InstRes[I].y;
	GMacroRes = InstRes[I].z;
	GDomain = InstRes[I].w;
}

// O ruído de detalhe faz as vezes do que a gravação não guarda abaixo do voxel
// (0.4 m na do WebGL): numa gravação mais fina ele encolhe junto, senão borra o
// detalhe que ela já traz
#define REF_VOXEL_M (38.0 / 96.0)
float NoiseK() { return min(GDomain / GRes / REF_VOXEL_M, 1.0); }

// =============================================================================
// a gravação (js/bake.js glsl(), instances.js BAKE_HELPERS)

float3 DomainMin() { return float3(-0.5 * GDomain, -0.5 * GDomain, 0.0); }
float3 ToVoxel(float3 Lp, float N) { return (Lp - DomainMin()) / GDomain * N; }

// o canto do slot no pool (em voxels de uma grade de N)
float3 SlotBase(float Slot, float N)
{
	const float Sz = floor(Slot / SlotsY + 1e-3);
	return float3(0.0, (Slot - Sz * SlotsY) * N, Sz * N);
}

// O bloco do quadro (no slot) que contém o voxel p de uma grade em que o bloco
// tem Side voxels (8 na resolução cheia, 4 na metade): onde ele está no atlas e
// a posição de p dentro dele. Falso = bloco vazio (sem fumaça).
#define BRICK 8.0
bool BrickOf(float3 P, float Slot, float Side, float GridRes, out float3 Atlas, out float3 Local)
{
	const float3 Page = clamp(floor(P / Side), 0.0, GridRes / Side - 1.0);
	const uint E = PoolPT.Load(int4(int3(Page + SlotBase(Slot, PTRes)), 0));
	Atlas = float3(E & 1023u, (E >> 10u) & 1023u, (E >> 20u) & 1023u);
	Local = P - Page * Side;
	return E != 0xFFFFFFFFu;
}

// um quadro da gravação no voxel p (trilinear; a borda do bloco tem o vizinho)
float4 SampleA(float3 P, float Slot)
{
	P = clamp(P, 0.5, GRes - 0.5);
	float3 B, L;
	if (!BrickOf(P, Slot, BRICK, GRes, B, L))
	{
		return 0.0;
	}
	return AtlasA.SampleLevel(LinearClamp, (B * (BRICK + 2.0) + 1.0 + L) / AtlasASize, 0);
}

// a meia resolução (combustível, velocidade): bloco de 4³ + borda; vazio = parado, sem combustível
float4 SampleF(float3 P, float Slot)
{
	float3 B, L;
	if (!BrickOf(P, Slot, BRICK * 0.5, GFuelRes, B, L))
	{
		return float4(0.0, 0.5, 0.5, 0.5);
	}
	return AtlasF.SampleLevel(LinearClamp, (B * (BRICK * 0.5 + 2.0) + 1.0 + L) / AtlasFSize, 0);
}

// esvaecimento junto ao teto e às laterais da caixa gravada (o chão é chão de verdade)
float BoxFade(float3 Vb)
{
	const float Top = smoothstep(0.0, GRes * 0.2, GRes - Vb.z);
	const float Side = smoothstep(0.0, 5.0 * GRes / 96.0, min(min(Vb.x, GRes - Vb.x), min(Vb.y, GRes - Vb.y)));
	return Top * Side;
}

// velocidade (m/s, local) no voxel da gravação: bilinear na fatia z mais próxima
float3 BakeVel(float3 VoxB, float Slot)
{
	float3 P = VoxB * (GFuelRes / GRes);
	P.xy = clamp(P.xy, 0.5, GFuelRes - 0.5);
	P.z = clamp(floor(P.z), 0.0, GFuelRes - 1.0) + 0.5;
	return (SampleF(P, Slot).gba * 2.0 - 1.0) * VelMax;
}

float FuelAt(float3 VoxF, float Slot)
{
	return SampleF(clamp(VoxF, 0.5, GFuelRes - 0.5), Slot).r;
}

float SampleFuel(float3 Lp, int I)
{
	const float3 P = ToVoxel(Lp, GFuelRes);
	const float Q = lerp(FuelAt(P, InstFrame[I].x), FuelAt(P, InstFrame[I].y), InstFrame[I].z);
	return Q * Q * FUEL_F;
}

// interpolação COM MOVIMENTO entre os quadros: o de baixo é levado pra frente,
// o de cima trazido pra trás, e só então se misturam
float4 BakeAtMV(float3 Voxel, int I, float3 V, float Dith)
{
	const float A = InstFrame[I].z, K = InstFrame[I].w;
	const float4 Qa = SampleA(Voxel - V * (A * K), InstFrame[I].x);
	const float4 Qb = SampleA(Voxel + V * ((1.0 - A) * K), InstFrame[I].y);
	float4 Q = lerp(Qa, Qb, A);
	Q.rgb = max(Q.rgb + Dith, 0.0);
	return float4(Q.r * Q.r * SOOT_F, Q.g * TEMP_F, Q.b * Q.b * DUST_F, Q.a);
}

float MacroAt(float3 Pm, float Slot)
{
	const int3 V = clamp(int3(floor(Pm)), 0, int(GMacroRes) - 1);
	return PoolM.Load(int4(V + int3(SlotBase(Slot, MacroRes)), 0));
}

// ocupação macro: o máximo dos dois quadros (o conteúdo no meio do intervalo está entre eles)
float Macro2(float3 Lp, int I)
{
	const float3 Pm = ToVoxel(Lp, GMacroRes);
	return max(MacroAt(Pm, InstFrame[I].x), MacroAt(Pm, InstFrame[I].y));
}

// distância (m locais) até sair do bloco macro atual
float MacroExit(float3 Lp, float3 Dir)
{
	const float3 Vp = ToVoxel(Lp, GMacroRes);
	const float3 Dv = Dir * (GMacroRes / GDomain) + float3(abs(Dir) < 1e-8) * 1e-8;
	const float3 Nb = floor(Vp) + step(0.0, Dv);
	const float3 Tb = (Nb - Vp) / Dv;
	return max(min(min(Tb.x, Tb.y), Tb.z), 0.0);
}

float4 WarpAt(int I, float3 Lp)
{
	const float Slot = InstLight[I].w;
	if (Slot < 0.0)
	{
		return 0.0;
	}
	const float3 Uvw = saturate((Lp - DomainMin()) / GDomain);
	return Slot < 0.5 ? Warp0.SampleLevel(LinearClamp, Uvw, 0) : Slot < 1.5 ? Warp1.SampleLevel(LinearClamp, Uvw, 0)
		: Slot < 2.5 ? Warp2.SampleLevel(LinearClamp, Uvw, 0) : Warp3.SampleLevel(LinearClamp, Uvw, 0);
}

// ruído de detalhe que anda com a fumaça (flow map em duas fases)
float3 FlowNoise(float3 Lp, float3 Vel, float TSeq, float Seed, out float3 R2)
{
	const float Ph = TSeq / FlowPeriod;
	float3 R = 0.0;
	float W2 = 0.0;
	R2 = 0.0;
	[unroll] for (int K = 0; K < 2; K++)
	{
		const float Pk = Ph + 0.5 * K;
		const float C = floor(Pk), Tk = Pk - C;
		const float W = 1.0 - abs(2.0 * Tk - 1.0);
		const float3 Off = float3(Seed * 7.3, Seed * 5.1, Seed * 3.1) + Hash33(float3(C, K, Seed)) * 17.0;
		const float3 Fp = (Lp - Vel * (Tk * FlowPeriod)) * DetailScale + Off;
		R += W * (Noise.SampleLevel(LinearWrap, Fp, 0).xyz * 2.0 - 1.0);
		if (DetailAmp2 > 0.0)
		{
			// a mesma advecção, 3.1× mais fina (volumeRender.js sampleMedium)
			R2 += W * (Noise.SampleLevel(LinearWrap, Fp * 3.1 + 0.41, 0).xyz * 2.0 - 1.0);
		}
		W2 += W * W;
	}
	R2 *= rsqrt(max(W2, 1e-4));
	return R * rsqrt(max(W2, 1e-4));
}

// As bolhas (billows) que andam com a fumaça: o Worley levado pela velocidade em
// duas fases, como o ruído de detalhe, mas num ciclo mais longo e com outro
// deslocamento (Neyret 2003). Média zero e desvio 1 por oitava (os canais têm
// média ~0.49 e desvio ~0.22, medidos): a explosão vista de longe não muda, só
// ganha forma. Ladrilho de 9.6 m: G = 1.2 m, B = 0.6 m, A = 0.3 m.
#define DETAIL_TILE_M 9.6
float BillowDetail(float3 Lp, float3 Vel, float TSeq, float Seed, int I)
{
	const float3 Fd = InstDetail[I].xyz;
	const float Ph = TSeq / DetailPeriod + 0.37;
	float D = 0.0, W2 = 0.0;
	[unroll] for (int K = 0; K < 2; K++)
	{
		const float Pk = Ph + 0.5 * K;
		const float C = floor(Pk), Tk = Pk - C;
		const float W = 1.0 - abs(2.0 * Tk - 1.0);
		const float3 Off = Hash33(float3(C, K + 5.0, Seed)) * 3.0;
		const float4 N = Worley.SampleLevel(LinearWrap, (Lp - Vel * (Tk * DetailPeriod)) / DETAIL_TILE_M + Off, 0);
		D += W * (Fd.x * (N.g - 0.488) / 0.225 + 0.5 * Fd.y * (N.b - 0.494) / 0.223 + 0.25 * Fd.z * (N.a - 0.493) / 0.224);
		W2 += W * W;
	}
	return D * rsqrt(max(W2, 1e-4));
}

// o meio num ponto local: r = fuligem, g = temperatura, b = poeira, a = transmitância do céu
float4 SampleInst(float3 LpIn, int I, float Dith)
{
	// deformada: lê no ponto de onde a fumaça veio, e o túnel sai da densidade
	const float4 Wp = WarpAt(I, LpIn);
	const float3 Lp = LpIn - Wp.xyz;
	const float3 Vel = BakeVel(ToVoxel(Lp, GRes), InstFrame[I].x);
	float3 N2;
	const float3 N = FlowNoise(Lp, Vel, InstMisc[I].x, InstMisc[I].y, N2);
	const float Kn = InstNoise[I].x;
	const float3 Voxel = ToVoxel(Lp + (N * DetailAmp + N2 * DetailAmp2) * (NoiseK() * Kn), GRes);
	float4 F = BakeAtMV(Voxel, I, Vel, Dith);
	const float Nm = (N.x + N.y + N.z) * 0.577;
	// o recorte sai primeiro onde o ruído é mais ralo: a borda do túnel sai rasgada (erosão do Nubis)
	const float Kept = saturate(1.0 - saturate(Wp.w) * (1.0 + (0.5 - 0.5 * Nm)));
	F.rb *= (1.0 + DetailDens * Kn * Nm) * BoxFade(Voxel) * InstMisc[I].z * Kept;
	const float Er = Erode * Kn * (0.5 - 0.5 * Nm);
	F.r = max(F.r - Er / (1.0 + F.r * 9.0), 0.0);
	F.b = max(F.b - Er * 0.7 / (1.0 + F.b * 9.0), 0.0);
	// as bolhas de perto: multiplicam a densidade que existe (não criam fumaça no
	// ar), forte na casca rala e quase nada no miolo, só na fase quente (os rolos
	// da bola de fogo; a fumaça velha fica com os fiapos do ruído acima)
	if (InstDetail[I].x > 0.0 && InstDetail[I].w > 0.0 && F.r + F.b > 1e-4)
	{
		const float Bd = BillowDetail(Lp, Vel, InstMisc[I].x, InstMisc[I].y, I) * InstDetail[I].w;
		F.r *= max(1.0 + DetailErode * Bd / (1.0 + F.r * 9.0), 0.0);
		F.b *= max(1.0 + DetailErode * 0.7 * Bd / (1.0 + F.b * 9.0), 0.0);
		F.g *= max(1.0 + DetailTemp * Bd, 0.0);
	}
	if (SharpPow > 0.0 && InstDetail[I].x > 0.0)
	{
		const float P = SharpPow * InstDetail[I].x;
		F.r *= pow(saturate(F.r / SharpRef), P);
		F.b *= pow(saturate(F.b / SharpRef), P);
	}
	return F;
}

// =============================================================================
// cache de luz (instances.js shLight): transmitância de cada célula até o sol e até o fogo

float ExtAt(float3 LpIn, int I)
{
	const float4 Wp = WarpAt(I, LpIn);
	const float3 Vb = ToVoxel(LpIn - Wp.xyz, GRes);
	const float4 Q = lerp(SampleA(Vb, InstFrame[I].x), SampleA(Vb, InstFrame[I].y), InstFrame[I].z);
	const float Fade = BoxFade(Vb);
	const float S = Q.r * Q.r * SOOT_F * Fade, D = Q.b * Q.b * DUST_F * Fade;
	const float ErodeMean = Erode * 0.5;
	const float R = max(S - ErodeMean / (1.0 + S * 9.0), 0.0);
	const float A = max(D - ErodeMean * 0.7 / (1.0 + D * 9.0), 0.0);
	return (SootExt * R + DustExt * A) * InstMisc[I].z * saturate(1.0 - 1.5 * saturate(Wp.w));
}

// espaço vazio: deformada, o macro é lido no ponto de origem e o salto é de um
// passo (a saída do bloco no espaço deformado não é a do raio)
bool MacroEmpty(float3 Lp, int I)
{
	return Macro2(Lp - WarpAt(I, Lp).xyz, I) < 0.004;
}
float MacroSkip(float3 Lp, float3 Dir, int I, float Dt)
{
	return InstLight[I].w >= 0.0 ? Dt : MacroExit(Lp, Dir) + 1e-3;
}

float MarchLight(float3 Lp, float3 Dir, float MaxDist, int Steps, float TauCap, int I)
{
	float2 Hit = RayBox(Lp, Dir, DomainMin(), DomainMin() + GDomain);
	Hit.x = max(Hit.x, 0.0);
	Hit.y = min(Hit.y, MaxDist);
	if (Hit.y <= Hit.x)
	{
		return 1.0;
	}
	const float Dt = (Hit.y - Hit.x) / float(Steps);
	const float Scale = InstFoot[I].w;
	float Tau = 0.0, T = Hit.x + Dt * 0.5;
	for (int K = 0; K < 48; K++)
	{
		if (T >= Hit.y)
		{
			break;
		}
		const float3 P = Lp + Dir * T;
		if (MacroEmpty(P, I))
		{
			T += MacroSkip(P, Dir, I, Dt);
			continue;
		}
		Tau += ExtAt(P, I) * Dt * Scale;
		if (Tau > TauCap)
		{
			break;
		}
		T += Dt;
	}
	return exp(-min(Tau, TauCap));
}

[numthreads(4, 4, 4)]
void MainLightCache(uint3 Id : SV_DispatchThreadID)
{
	const uint N = uint(LCRes);
	if (any(Id >= N))
	{
		return;
	}
	InitLights();
	const int I = LCInstance;
	UseRes(I);
	const float3 Lp = DomainMin() + (float3(Id) + 0.5) / LCRes * GDomain;
	float2 O = 1.0;
	if (!MacroEmpty(Lp, I))
	{
		const float3 FireL = (InstFirePos[I].xyz - InstFoot[I].xyz) / InstFoot[I].w;
		const float3 Tf = FireL - Lp;
		const float Fd = length(Tf);
		O.x = MarchLight(Lp, KeyDir, 1e4, SunSteps, 60.0, I);
		// tauCap baixo: a luz pontual no centróide atravessaria a bola de fogo inteira
		O.y = Fd < 1e-3 ? 1.0 : MarchLight(Lp, Tf / Fd, Fd, FireSteps, 2.2, I);
	}
	PoolLCOut[uint3(Id.x, Id.y, Id.z + uint(LCSlot) * N)] = O;
}

float2 LightCacheAt(float3 Lp, float Slot)
{
	float3 P = ToVoxel(Lp, LCRes);
	P.z = clamp(P.z, 0.5, LCRes - 0.5) + Slot * LCRes;
	return PoolLC.SampleLevel(LinearClamp, P / float3(LCRes, LCRes, LCRes * LCSlots), 0);
}

// =============================================================================
// a marcha (instances.js shSingle), meia resolução

float3 RayDir(float2 UvOut)
{
	const float2 Ndc = float2(UvOut.x * 2.0 - 1.0, 1.0 - UvOut.y * 2.0);
	const float4 P = mul(float4(Ndc, 1.0, 1.0), ClipToCamera);
	return normalize(P.xyz / P.w);
}

// distância da câmera até a cena (m) no ponto da tela UvOut, ao longo de Rd
float SceneDist(float2 UvOut, float3 Rd)
{
	const float2 Pix = View.ViewRectMin.xy + UvOut * View.ViewSizeAndInvSize.xy;
	const float DeviceZ = SceneDepth.Load(int3(int2(Pix), 0));
	if (DeviceZ <= 1e-7)
	{
		return 1e9;
	}
	const float ViewZ = ConvertFromDeviceZ(DeviceZ) * 0.01;
	return ViewZ / max(dot(Rd, CameraForward), 1e-4);
}

// a cena mais perto e a mais longe (m, ao longo de Rd) entre os pixels da profundidade que o texel Id
// da marcha cobre (a profundidade está na resolução interna; até 5×5 por texel no ¼ da resolução)
void SceneDistRange(uint2 Id, float3 Rd, out float DNear, out float DFar)
{
	const float2 Px = View.ViewSizeAndInvSize.xy / float2(HalfSize);
	const int2 P0 = int2(floor(View.ViewRectMin.xy + float2(Id) * Px));
	const int2 P1 = max(int2(ceil(View.ViewRectMin.xy + float2(Id + 1) * Px)) - 1, P0);
	const int2 PMax = int2(View.ViewRectMin.xy + View.ViewSizeAndInvSize.xy) - 1;
	float ZMin = 1.0, ZMax = 0.0;   // DeviceZ invertido: maior = mais perto
	for (int Y = P0.y; Y <= min(P1.y, P0.y + 4); Y++)
	{
		for (int X = P0.x; X <= min(P1.x, P0.x + 4); X++)
		{
			const float Z = SceneDepth.Load(int3(min(int2(X, Y), PMax), 0));
			ZMin = min(ZMin, Z);
			ZMax = max(ZMax, Z);
		}
	}
	const float K = 1.0 / max(dot(Rd, CameraForward), 1e-4);
	DFar = ZMin <= 1e-7 ? 1e9 : ConvertFromDeviceZ(ZMin) * 0.01 * K;
	DNear = ZMax <= 1e-7 ? 1e9 : ConvertFromDeviceZ(ZMax) * 0.01 * K;
}

// a marcha de uma explosão até TScene (a camada de trás); Near volta com o que ela juntou até TNear (a da frente)
float4 MarchInstance(int I, float3 Rd, float TScene, float TNear, float2 Pix, inout float DepthSum, inout float DepthW, out float4 Near)
{
	UseRes(I);
	Near = float4(0.0, 0.0, 0.0, 1.0);
	float2 Hit = RayBox(0.0, Rd, InstBoxMin[I].xyz, InstBoxMax[I].xyz);
	Hit.x = max(Hit.x, NearM);
	Hit.y = min(Hit.y, TScene);
	if (Hit.y <= Hit.x)
	{
		return float4(0.0, 0.0, 0.0, 1.0);
	}
	bool bNear = false;
	const int Steps = int(InstMisc[I].w);
	const float Span = Hit.y - Hit.x;
	const float Dt = Span / float(Steps);
	float T = Hit.x + Dt * IGNoise(Pix + Jitter * 71.13);
	const float3 Foot = InstFoot[I].xyz;
	const float Scale = InstFoot[I].w;
	const float Thick = InstLight[I].y;
	const float LcSlot = InstLight[I].x;
	const float3 FirePos = InstFirePos[I].xyz;
	const float3 FireColor = InstFireCol[I].rgb;

	const float CosSun = dot(Rd, KeyDir);
	const float PhSun = PhaseDual(CosSun, PhaseG, PhaseBack, PhaseMix);
	const float PhIso = 1.0 / (4.0 * PI_F);

	float3 L = 0.0;
	float Tr[4] = { 1.0, 1.0, 1.0, 1.0 };
	for (int S = 0; S < MAX_STEPS; S++)
	{
		// passou pela cena mais perto do bloco: o que juntou até aqui é a camada da frente
		if (!bNear && T >= TNear)
		{
			bNear = true;
			Near = float4(L, Tr[0]);
		}
		if (S >= Steps || T >= Hit.y || Tr[0] < 0.004)
		{
			break;
		}
		const float3 W = Rd * T;
		const float3 Lpw = (W - Foot) / Scale;
		// pula espaço vazio pelo macro gravado
		if (MacroEmpty(Lpw, I))
		{
			T += MacroSkip(Lpw, Rd, I, Dt / Scale) * Scale;
			continue;
		}
		const float Dith = (IGNoise(Pix + float(S) * float2(5.588, 3.17)) - 0.5) / 255.0;
		const float4 F = SampleInst(Lpw, I, Dith);
		if (F.r + F.b > 1e-4)
		{
			const float SigSoot = SootExt * F.r * Thick, SigDust = DustExt * F.b * Thick;
			const float SigT = SigSoot + SigDust;
			const float WS = SigSoot / max(SigT, 1e-5);
			const bool bOwnDust = InstDust[I].x >= 0.0;
			const float3 ScatCol = lerp(bOwnDust ? InstDust[I].rgb : DustColor, InstLook[I].rgb, WS);
			const float Albedo = lerp(bOwnDust ? InstDust[I].a : DustAlbedo, InstLook[I].a, WS);
			// a luz desta explosão (o sol inteiro, o céu e a areia por explosão; negativo = as globais)
			const float3 KeyI = InstLight2[I].x >= 0.0 ? KeySun * lerp(max(KeyDir.z, 0.0), 1.0, InstLight2[I].x) : KeyColor;
			const float SkyI = InstLight2[I].y >= 0.0 ? InstLight2[I].y : SkyGain;
			const float3 GroundI = InstGround[I].w > 0.5 ? KeyGround * InstGround[I].rgb * (1.0 / PI_F) : GroundColor;

			// corpo negro com o reforço na frente de chama (onde ainda há combustível)
			// no clarão, só o miolo que já é fogo esquenta (a casca fria não acende)
			const float Fl = InstFirePos[I].w;
			const float TN = saturate((F.g + FlashDT * Fl * smoothstep(0.12, 0.45, F.g)) * TempScale);
			const float4 Bb = BlackBody.SampleLevel(LinearClamp, float2(TN, 0.5), 0);
			float Flame = 1.0;
			if (F.g > 0.12)
			{
				Flame += FlameBoost * smoothstep(0.02, 0.35, SampleFuel(Lpw, I));
			}
			const float3 Emit = Bb.rgb * (pow(max(Bb.a, 0.0), EmissionCurve) * EmissionGain * InstLight[I].z * Flame * (1.0 + FlashGain * Fl))
				* (SigSoot * (1.0 - InstLook[I].a));

			// luz: do cache (marchado neste quadro) ou a transmitância do céu gravada
			const float FadeM = BoxFade(ToVoxel(Lpw, GRes));
			const float SkyT = lerp(1.0, F.a, FadeM);
			float SunT, FireT;
			if (LcSlot >= 0.0)
			{
				const float2 Lc = LightCacheAt(Lpw, LcSlot);
				SunT = lerp(1.0, Lc.x, FadeM);
				FireT = lerp(1.0, Lc.y, FadeM);
			}
			else
			{
				SunT = pow(SkyT, SunOcclude);
				FireT = SkyT;
			}
			if (DebugView > 0)
			{
				// a transmitância como brilho próprio de um meio cinza (0.05 = um chão claro ao sol)
				const float V = DebugView == 1 ? SunT : (DebugView == 2 ? FireT : SkyT);
				const float TrStep = exp(-SigT * Dt);
				L += Tr[0] * V * 0.05 * (1.0 - TrStep);
				Tr[0] *= TrStep;
				T += Dt;
				continue;
			}
			const float Fd = length(FirePos - W);
			const float3 FireIrr = FireColor * FireGain * FireT / (1.0 + Fd * Fd * 0.05);

			// oitavas de espalhamento múltiplo
			float Ae = 1.0, Ab = 1.0, Ap = 1.0;
			[unroll] for (int O = 0; O < 4; O++)
			{
				if (O < MsOctaves)
				{
					const float Sig = SigT * Ae;
					const float Sc = Sig * Albedo * Ab;
					const float Ph = lerp(PhIso, PhSun, Ap);
					const float TSun = lerp(1.0, SunT, Ap);
					const float TSky = lerp(1.0, SkyT, Ap * 0.7 + 0.3);
					const float3 Src = ScatCol * Sc * (KeyI * (TSun * Ph * TermGain.x)
						+ (SkyColor * TSky + GroundI * lerp(1.0, FireT, Ap * 0.7 + 0.3)) * (SkyI * PhIso * TermGain.y)
						+ FireIrr * (lerp(PhIso, PhSun, Ap * 0.5) * TermGain.z))
						+ Emit * (Ab * TermGain.w);
					const float Ext = max(Sig, 1e-5);
					const float TrStep = exp(-Ext * Dt);
					L += Tr[O] * (Src - Src * TrStep) / Ext;
					Tr[O] *= TrStep;
					Ae *= MsExt;
					Ab *= MsScatter;
					Ap *= MsPhase;
				}
			}
			// profundidade média pela cobertura (volumeRender.js): por onde o acúmulo reprojeta
			const float C = 1.0 - Tr[0];
			DepthSum += T * C;
			DepthW += C;
		}
		T += Dt;
	}
	if (!bNear)
	{
		Near = float4(L, Tr[0]);   // acabou antes da cena da frente: a frente vê o volume inteiro
	}
	return float4(L, Tr[0]);
}

// A marcha CONJUNTA (instances.js, a do WebGL; perdida no porte e de volta em 12/10): o raio anda uma vez
// pela cena e em cada passo soma todas as explosões cuja caixa contém o ponto. Marchar uma de cada vez e pôr
// uma inteira na frente da outra errava a ordem onde elas se cruzam (o Felipe: a areia de uma explosão velha
// passando por cima das novas). A luz de cada uma segue sendo a dela (cache, céu, fogo próprio); o fogo de
// uma acendendo a fumaça da outra (o resto da marcha conjunta do WebGL) é o próximo passo.
#define JOINT_MAX 8
int JointMarch;
float4 MarchJoint(float3 Rd, float TScene, float TNear, float2 Pix, inout float DepthSum, inout float DepthW, out float4 Near)
{
	Near = float4(0.0, 0.0, 0.0, 1.0);
	// as que o raio atravessa (as mais perto primeiro: a lista já vem ordenada pela distância)
	int Ids[JOINT_MAX];
	float T0[JOINT_MAX], T1[JOINT_MAX], DtI[JOINT_MAX];
	int K = 0;
	float TMin = 1e9, TMax = -1e9, DtMin = 1e9;
	for (int I = 0; I < NumInstances && K < JOINT_MAX; I++)
	{
		float2 Hit = RayBox(0.0, Rd, InstBoxMin[I].xyz, InstBoxMax[I].xyz);
		Hit.x = max(Hit.x, NearM);
		Hit.y = min(Hit.y, TScene);
		if (Hit.y > Hit.x)
		{
			Ids[K] = I;
			T0[K] = Hit.x;
			T1[K] = Hit.y;
			DtI[K] = (Hit.y - Hit.x) / max(InstMisc[I].w, 1.0);
			TMin = min(TMin, Hit.x);
			TMax = max(TMax, Hit.y);
			DtMin = min(DtMin, DtI[K]);
			K++;
		}
	}
	if (K == 0)
	{
		return float4(0.0, 0.0, 0.0, 1.0);
	}
	// o orçamento de passos: o de quem mais pede, espalhado na faixa toda do raio. Com o passo de cada uma
	// valendo sozinho, as saias de poeira largas (caixa de 38 m) somavam passos curtos ao longo da faixa toda
	// e a marcha das 6 Cargas com poeira ia de 5,8 (uma de cada vez) a 14,5 ms; com o teto × 1,5, 8,7 ms e a
	// mesma imagem (captures/ue/conjunta_teto.jpg); × 1 (12/10) pra ficar perto da de uma de cada vez
	float Budget = 1.0;
	for (int B = 0; B < K; B++)
	{
		Budget = max(Budget, InstMisc[Ids[B]].w);
	}
	const float DtFloor = (TMax - TMin) / min(Budget, float(MAX_STEPS));
	const float CosSun = dot(Rd, KeyDir);
	const float PhSun = PhaseDual(CosSun, PhaseG, PhaseBack, PhaseMix);
	const float PhIso = 1.0 / (4.0 * PI_F);
	bool bNear = false;
	float3 L = 0.0;
	float Tr[4] = { 1.0, 1.0, 1.0, 1.0 };
	float T = TMin + DtMin * IGNoise(Pix + Jitter * 71.13);
	for (int S = 0; S < MAX_STEPS * 3; S++)
	{
		if (!bNear && T >= TNear)
		{
			bNear = true;
			Near = float4(L, Tr[0]);
		}
		if (T >= TMax || Tr[0] < 0.004)
		{
			break;
		}
		const float3 W = Rd * T;
		const float Dith = (IGNoise(Pix + float(S) * float2(5.588, 3.17)) - 0.5) / 255.0;
		float Dt = 1e9, Skip = 1e9, NextIn = 1e9;
		bool bAny = false;
		float3 SrcO[4] = { (float3)0.0, (float3)0.0, (float3)0.0, (float3)0.0 };
		float ExtO[4] = { 0.0, 0.0, 0.0, 0.0 };
		float DebugV = 0.0;
		for (int J = 0; J < K; J++)
		{
			if (T < T0[J])
			{
				NextIn = min(NextIn, T0[J]);
				continue;
			}
			if (T >= T1[J])
			{
				continue;
			}
			const int I = Ids[J];
			UseRes(I);
			const float3 Foot = InstFoot[I].xyz;
			const float Scale = InstFoot[I].w;
			const float3 Lpw = (W - Foot) / Scale;
			if (MacroEmpty(Lpw, I))
			{
				Skip = min(Skip, MacroSkip(Lpw, Rd, I, DtI[J] / Scale) * Scale);
				continue;
			}
			bAny = true;
			Dt = min(Dt, DtI[J]);
			const float4 F = SampleInst(Lpw, I, Dith);
			if (F.r + F.b <= 1e-4)
			{
				continue;
			}
			const float Thick = InstLight[I].y;
			const float SigSoot = SootExt * F.r * Thick, SigDust = DustExt * F.b * Thick;
			const float SigT = SigSoot + SigDust;
			const float WS = SigSoot / max(SigT, 1e-5);
			const bool bOwnDust = InstDust[I].x >= 0.0;
			const float3 ScatCol = lerp(bOwnDust ? InstDust[I].rgb : DustColor, InstLook[I].rgb, WS);
			const float Albedo = lerp(bOwnDust ? InstDust[I].a : DustAlbedo, InstLook[I].a, WS);
			// a luz desta explosão (o sol inteiro, o céu e a areia por explosão; negativo = as globais)
			const float3 KeyI = InstLight2[I].x >= 0.0 ? KeySun * lerp(max(KeyDir.z, 0.0), 1.0, InstLight2[I].x) : KeyColor;
			const float SkyI = InstLight2[I].y >= 0.0 ? InstLight2[I].y : SkyGain;
			const float3 GroundI = InstGround[I].w > 0.5 ? KeyGround * InstGround[I].rgb * (1.0 / PI_F) : GroundColor;
			// corpo negro com o reforço na frente de chama; no clarão só o miolo que já é fogo esquenta
			const float Fl = InstFirePos[I].w;
			const float TN = saturate((F.g + FlashDT * Fl * smoothstep(0.12, 0.45, F.g)) * TempScale);
			const float4 Bb = BlackBody.SampleLevel(LinearClamp, float2(TN, 0.5), 0);
			float Flame = 1.0;
			if (F.g > 0.12)
			{
				Flame += FlameBoost * smoothstep(0.02, 0.35, SampleFuel(Lpw, I));
			}
			const float3 Emit = Bb.rgb * (pow(max(Bb.a, 0.0), EmissionCurve) * EmissionGain * InstLight[I].z * Flame * (1.0 + FlashGain * Fl))
				* (SigSoot * (1.0 - InstLook[I].a));
			// luz: do cache (marchado neste quadro) ou a transmitância do céu gravada
			const float FadeM = BoxFade(ToVoxel(Lpw, GRes));
			const float SkyT = lerp(1.0, F.a, FadeM);
			float SunT, FireT;
			const float LcSlot = InstLight[I].x;
			if (LcSlot >= 0.0)
			{
				const float2 Lc = LightCacheAt(Lpw, LcSlot);
				SunT = lerp(1.0, Lc.x, FadeM);
				FireT = lerp(1.0, Lc.y, FadeM);
			}
			else
			{
				SunT = pow(SkyT, SunOcclude);
				FireT = SkyT;
			}
			if (DebugView > 0)
			{
				DebugV += (DebugView == 1 ? SunT : (DebugView == 2 ? FireT : SkyT)) * SigT;
				ExtO[0] += SigT;
				continue;
			}
			const float Fd = length(InstFirePos[I].xyz - W);
			const float3 FireIrr = InstFireCol[I].rgb * FireGain * FireT / (1.0 + Fd * Fd * 0.05);
			float Ae = 1.0, Ab = 1.0, Ap = 1.0;
			[unroll] for (int O = 0; O < 4; O++)
			{
				if (O < MsOctaves)
				{
					const float Sig = SigT * Ae;
					const float Sc = Sig * Albedo * Ab;
					const float Ph = lerp(PhIso, PhSun, Ap);
					const float TSun = lerp(1.0, SunT, Ap);
					const float TSky = lerp(1.0, SkyT, Ap * 0.7 + 0.3);
					SrcO[O] += ScatCol * Sc * (KeyI * (TSun * Ph * TermGain.x)
						+ (SkyColor * TSky + GroundI * lerp(1.0, FireT, Ap * 0.7 + 0.3)) * (SkyI * PhIso * TermGain.y)
						+ FireIrr * (lerp(PhIso, PhSun, Ap * 0.5) * TermGain.z))
						+ Emit * (Ab * TermGain.w);
					ExtO[O] += Sig;
					Ae *= MsExt;
					Ab *= MsScatter;
					Ap *= MsPhase;
				}
			}
		}
		if (!bAny)
		{
			// ninguém ocupado aqui: salta o vazio, sem passar da entrada da próxima caixa
			const float Nt = min(T + Skip, NextIn);
			if (Nt > 1e8)
			{
				break;
			}
			T = max(Nt, T + 1e-3);
			continue;
		}
		Dt = max(Dt, DtFloor);      // a integração e o avanço com o mesmo passo
		if (DebugView > 0)
		{
			const float TrStep = exp(-ExtO[0] * Dt);
			L += Tr[0] * (DebugV / max(ExtO[0], 1e-5)) * 0.05 * (1.0 - TrStep);
			Tr[0] *= TrStep;
		}
		else
		{
			[unroll] for (int O = 0; O < 4; O++)
			{
				if (O < MsOctaves)
				{
					const float Ext = max(ExtO[O], 1e-5);
					const float TrStep = exp(-Ext * Dt);
					L += Tr[O] * (SrcO[O] - SrcO[O] * TrStep) / Ext;
					Tr[O] *= TrStep;
				}
			}
		}
		// profundidade média pela cobertura (volumeRender.js): por onde o acúmulo reprojeta
		const float C = 1.0 - Tr[0];
		DepthSum += T * C;
		DepthW += C;
		T += Dt;
	}
	if (!bNear)
	{
		Near = float4(L, Tr[0]);
	}
	return float4(L, Tr[0]);
}

[numthreads(8, 8, 1)]
void MainMarch(uint2 Id : SV_DispatchThreadID)
{
	if (any(Id >= HalfSize))
	{
		return;
	}
	InitLights();
	const float2 Uv = (float2(Id) + 0.5) / float2(HalfSize);
	const float3 Rd = RayDir(Uv);
	float TNear, TScene;
	SceneDistRange(Id, Rd, TNear, TScene);
	float DepthSum = 0.0, DepthW = 0.0;
	float4 Near, Far;
	if (JointMarch > 0)
	{
		Far = MarchJoint(Rd, TScene, TNear, float2(Id), DepthSum, DepthW, Near);
	}
	else
	{
		// uma de cada vez (até 12/10; -RmJoint=0 compara): a de trás vista pela transmitância da da frente
		float3 L = 0.0, Ln = 0.0;
		float Tr = 1.0, Trn = 1.0;
		for (int I = 0; I < NumInstances; I++)
		{
			float4 Rn;
			const float4 R = MarchInstance(I, Rd, TScene, TNear, float2(Id), DepthSum, DepthW, Rn);
			L += Tr * R.rgb;
			Tr *= R.a;
			Ln += Trn * Rn.rgb;
			Trn *= Rn.a;
			if (Trn < 0.004)
			{
				break;
			}
		}
		Far = float4(L, Tr);
		Near = float4(Ln, Trn);
	}
	VolOut[Id] = Far;
	VolNearOut[Id] = Near;
	VolDepthOut[Id] = float4(min(TScene, 1e8), DepthW > 1e-4 ? DepthSum / DepthW : min(TScene, 1e4), min(TNear, 1e8), 0.0);
}

// =============================================================================
// acúmulo temporal (o das nuvens e da névoa volumétrica dos AAA: Schneider,
// "The Real-time Volumetric Cloudscapes of Horizon Zero Dawn", SIGGRAPH 2015;
// Hillaire, "Physically Based and Unified Volumetric Rendering in Frostbite",
// SIGGRAPH 2015): a marcha de cada quadro começa num ponto sorteado diferente
// (o jitter), e a média ao longo dos quadros tira o granulado. A história é
// levada pela profundidade média do volume até onde ela estava no quadro
// anterior e presa entre o mínimo e o máximo da vizinhança 3×3 do quadro novo
// (sem rastro quando a fumaça anda ou a câmera gira).

[numthreads(8, 8, 1)]
void MainTemporal(uint2 Id : SV_DispatchThreadID)
{
	if (any(Id >= HalfSize))
	{
		return;
	}
	// as duas camadas, cada uma presa na vizinhança dela, levadas pelo mesmo movimento
	const float4 Cur = VolIn[Id], CurN = VolNearIn[Id];
	if (HistValid < 0.5)
	{
		HistOut[Id] = Cur;
		HistNearOut[Id] = CurN;
		return;
	}
	float4 Mn = Cur, Mx = Cur, MnN = CurN, MxN = CurN;
	[unroll] for (int Dy = -1; Dy <= 1; Dy++)
	{
		[unroll] for (int Dx = -1; Dx <= 1; Dx++)
		{
			const int2 Q = clamp(int2(Id) + int2(Dx, Dy), 0, int2(HalfSize) - 1);
			const float4 V = VolIn[Q], VN = VolNearIn[Q];
			Mn = min(Mn, V);
			Mx = max(Mx, V);
			MnN = min(MnN, VN);
			MxN = max(MxN, VN);
		}
	}
	const float2 Uv = (float2(Id) + 0.5) / float2(HalfSize);
	const float3 P = RayDir(Uv) * VolDepthIn[Id].y;
	const float4 C = mul(float4(P, 1.0), CamToPrevClip);
	const float2 PrevUv = float2(C.x / C.w * 0.5 + 0.5, 0.5 - C.y / C.w * 0.5);
	if (C.w <= 1e-4 || any(PrevUv < 0.0) || any(PrevUv > 1.0))
	{
		HistOut[Id] = Cur;
		HistNearOut[Id] = CurN;
		return;
	}
	HistOut[Id] = lerp(clamp(HistIn.SampleLevel(LinearClamp, PrevUv, 0), Mn, Mx), Cur, HistAlpha);
	HistNearOut[Id] = lerp(clamp(HistNearIn.SampleLevel(LinearClamp, PrevUv, 0), MnN, MxN), CurN, HistAlpha);
}

// =============================================================================
// a sombra no chão (13/10; o Felipe: "parece um PNG em cima do cenário", a nuvem não escurecia nada): pra cada texel
// de um plano no chão, a espessura óptica até o sol através de todas as explosões. A light function do sol
// (M_SmokeShadowLF, a mesma da fumaça de campo) leva o ponto ao plano ao longo do sol e tira e^−τ da luz direta: a
// sombra cai longe com o sol baixo, nas casas e nas unidades, e respeita as sombras que já existem (só a luz direta).
// As "transmittance/opacity shadow maps" das nuvens e da fumaça dos AAA (Frostbite, Hillaire 2016; as nuvens da Unreal).

[numthreads(8, 8, 1)]
void MainShadowMap(uint2 Id : SV_DispatchThreadID)
{
	const int Res = int(ShadowB.w);
	if (any(int2(Id) >= Res))
	{
		return;
	}
	const float3 P = float3(ShadowA.xy + (float2(Id) + 0.5) * ShadowA.z, ShadowA.w);
	const float3 L = ShadowB.xyz;
	float Tau = 0.0;
	for (int I = 0; I < NumInstances; I++)
	{
		UseRes(I);
		float2 Hit = RayBox(P, L, InstBoxMin[I].xyz, InstBoxMax[I].xyz);
		Hit.x = max(Hit.x, 0.0);
		if (Hit.y <= Hit.x)
		{
			continue;
		}
		const int N = 24;
		const float Dt = (Hit.y - Hit.x) / float(N);
		const float Thick = InstLight[I].y;
		for (int S = 0; S < N; S++)
		{
			const float3 W = P + L * (Hit.x + (float(S) + 0.5) * Dt);
			const float3 Lpw = (W - InstFoot[I].xyz) / InstFoot[I].w;
			if (MacroEmpty(Lpw, I))
			{
				continue;
			}
			const float4 F = SampleInst(Lpw, I, 0.0);
			Tau += (SootExt * F.r + DustExt * F.b) * Thick * Dt;
		}
	}
	ShadowOut[Id] = Tau;
}

// =============================================================================
// composite (volumeRender.js shComposite): upsample pela profundidade, agora com
// as duas camadas de cada um dos 4 texels vizinhos (8 candidatos, cada um com a
// profundidade até onde marchou): o peso bilinear vezes o quanto a profundidade
// dele concorda com a do pixel (upsample bilateral, Kopf et al. 2007; a escolha
// pela profundidade mais parecida, Bavoil/NVIDIA). Nenhum concorda: o mais parecido.

[numthreads(8, 8, 1)]
void MainComposite(uint2 Id : SV_DispatchThreadID)
{
	if (any(Id >= OutExtent))
	{
		return;
	}
	float4 Scene = SceneColorIn[Id];
	if (all(Id >= OutMin) && all(Id < OutMin + OutSize))
	{
		const float2 Uv = (float2(Id - OutMin) + 0.5) / float2(OutSize);
		const float3 Rd = RayDir(Uv);
		const float DRef = min(SceneDist(Uv, Rd), 1e8);
		const float2 Hp = Uv * float2(HalfSize) - 0.5;
		const int2 Base = int2(floor(Hp));
		// A regra das nuvens da Unreal (VolumetricRenderTarget.usf, CLOUD_MIN_AND_MAX_DEPTH, 12/10):
		// onde a cena dos 4 texels vizinhos é uma superfície só (a faixa entre a mais perto e a mais longe
		// cabe na tolerância), bilinear macio; senão, NENHUMA mistura: o pixel pega o candidato (dos 8: 4
		// texels × frente/trás) cuja profundidade mais se parece com a dele. A mistura com pesos (Kopf
		// 2007) que havia aqui borrava o fogo por cima das folhas (o Felipe, 12/10: "só deu uma
		// suavizada"); o Pesce (BO3) já avisava que o peso de semelhança dá artefato na borda.
		// E a profundidade do pixel cai DENTRO da faixa de um texel (uma folha no meio da bola, na
		// floresta): o valor dele nessa profundidade é a interpolação entre a camada da frente e a de trás
		// (a integral só cresce entre as duas; a pesquisa de 11/10: "interpolar luz e transmitância na
		// profundidade real do pixel"). Sem isso a folha meio dentro do fogo tinha de escolher "fogo todo"
		// ou "nenhum": quadradinhos laranja nas copas. Entre os texels que contêm a profundidade, bilinear.
		const float Tol = max(DRef * 0.06, 0.25);
		const float2 Fr = Hp - float2(Base);
		float4 BestV = float4(0.0, 0.0, 0.0, 1.0), Acc = 0.0;
		float Best = 1e20, DMin = 1e20, DMax = 0.0, WSum = 0.0;
		[unroll] for (int K = 0; K < 4; K++)
		{
			const int2 Q = clamp(Base + int2(K & 1, K >> 1), 0, int2(HalfSize) - 1);
			const float4 D = VolDepthIn[Q];
			DMin = min(DMin, D.z);
			DMax = max(DMax, D.x);
			const float4 Vn = VolNearIn[Q], Vf = VolIn[Q];
			// dentro da faixa [perto, longe] deste texel (com a tolerância): o valor na profundidade do pixel
			if (DRef > D.z - Tol && DRef < D.x + Tol)
			{
				const float A = saturate((DRef - D.z) / max(D.x - D.z, 1e-3));
				const float Wb = ((K & 1) ? Fr.x : 1.0 - Fr.x) * ((K >> 1) ? Fr.y : 1.0 - Fr.y) + 1e-4;
				Acc += Wb * lerp(Vn, Vf, A);
				WSum += Wb;
			}
			[unroll] for (int Ly = 0; Ly < 2; Ly++)
			{
				const float Diff = abs((Ly == 0 ? D.x : D.z) - DRef);
				if (Diff < Best)
				{
					Best = Diff;
					BestV = Ly == 0 ? Vf : Vn;
				}
			}
		}
		const float4 Vol = DMax - DMin < Tol ? VolIn.SampleLevel(LinearClamp, Uv, 0) : (WSum > 0.0 ? Acc / WSum : BestV);
		float3 VolL = Vol.rgb;
		if (FogA.x > 0.5 && Vol.a < 0.999)
		{
			// A névoa do mapa entre a câmera e a explosão (13/10; o Felipe: "parece um PNG em cima do cenário"). A cena
			// já vem com a névoa; a explosão vinha limpa por cima. A mesma névoa de altura da Unreal (HeightFogCommon:
			// densidade × 2^(−queda·(z − altura)), integrada no raio), do começo dela até a profundidade média da
			// explosão; a luz é a volumétrica (albedo, fase do sol + céu). Ela some o tanto que a explosão tapa a cena
			// (a cena atrás já tem a névoa dela) e cobre a explosão.
			const float Dv = min(VolDepthIn[clamp(int2(Uv * float2(HalfSize)), 0, int2(HalfSize) - 1)].y, DRef);
			const float S0 = FogA.w, S1 = max(Dv, S0);
			const float Fz = FogA.z * Rd.z;
			const float Z0 = -FogHeightRel;            // a altura da câmera acima da névoa (m)
			float Line;
			if (abs(Fz) > 1e-4)
			{
				Line = exp2(-FogA.z * Z0) * (exp2(-Fz * S0) - exp2(-Fz * S1)) / (Fz * 0.69314718);
			}
			else
			{
				Line = exp2(-FogA.z * Z0) * (S1 - S0);
			}
			const float FogT = exp(-FogA.y * max(Line, 0.0));
			InitLights();
			const float CosS = dot(Rd, KeyDir);
			const float G = FogB.w, G2 = G * G;
			const float Hg = (1.0 - G2) / (4.0 * PI_F * pow(max(1.0 + G2 - 2.0 * G * CosS, 1e-4), 1.5));
			const float3 Src = FogB.rgb * (KeyGround * Hg + SkyColor * (1.0 / (4.0 * PI_F)));
			VolL = Vol.rgb * FogT + Src * (1.0 - FogT) * (1.0 - Vol.a);
		}
		Scene.rgb = Scene.rgb * Vol.a + VolL * (RadianceScale * View.PreExposure);
	}
	SceneColorOut[Id] = Scene;
}
