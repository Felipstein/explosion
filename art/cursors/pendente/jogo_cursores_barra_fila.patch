+	const FColor Fill = bBuild ? Mix(Blue, Cyan, R) : (R >= 0.5f ? Mix(Yellow, Green, (R - 0.5f) / 0.5f) : Mix(Red, Yellow, R / 0.5f));
+	const FColor Edge(uint8(Fill.R * 0.28f), uint8(Fill.G * 0.28f), uint8(Fill.B * 0.28f));
